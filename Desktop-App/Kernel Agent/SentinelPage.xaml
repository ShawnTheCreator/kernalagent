<Page
    x:Class="Kernel_Agent.SentinelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <ScrollViewer>
            <StackPanel Spacing="20" Margin="20">
                
                <!-- Header -->
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <Border Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                            CornerRadius="50" Width="60" Height="60">
                        <TextBlock Text="🛡️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sentinel Agent" Style="{StaticResource TitleTextBlockStyle}" FontSize="28"/>
                        <TextBlock Text="Hardware Monitoring & PC Optimization" Style="{StaticResource SubtitleTextBlockStyle}" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- System Status Overview -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="System Health Overview" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Status -->
                            <Border Grid.Column="0" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    CornerRadius="8" Padding="15" Margin="0,0,5,0">
                                <StackPanel>
                                    <TextBlock Text="💻" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Name="CpuUsageText" Text="0%" HorizontalAlignment="Center" 
                                               Style="{StaticResource HeaderTextBlockStyle}" FontSize="20"/>
                                    <TextBlock Name="CpuStatusText" Text="Normal" HorizontalAlignment="Center" 
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Memory Status -->
                            <Border Grid.Column="1" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    CornerRadius="8" Padding="15" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="🧠" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Name="MemoryUsageText" Text="0%" HorizontalAlignment="Center" 
                                               Style="{StaticResource HeaderTextBlockStyle}" FontSize="20"/>
                                    <TextBlock Name="MemoryStatusText" Text="Normal" HorizontalAlignment="Center" 
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Temperature Status -->
                            <Border Grid.Column="2" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    CornerRadius="8" Padding="15" Margin="5,0">
                                <StackPanel>
                                    <TextBlock Text="🌡️" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Name="TemperatureText" Text="0°C" HorizontalAlignment="Center" 
                                               Style="{StaticResource HeaderTextBlockStyle}" FontSize="20"/>
                                    <TextBlock Name="ThermalStatusText" Text="Normal" HorizontalAlignment="Center" 
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Border>

                            <!-- Overall Status -->
                            <Border Grid.Column="3" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    CornerRadius="8" Padding="15" Margin="5,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="📊" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Name="OverallStatusText" Text="Normal" HorizontalAlignment="Center" 
                                               Style="{StaticResource HeaderTextBlockStyle}" FontSize="20"/>
                                    <TextBlock Text="Processes: 0" HorizontalAlignment="Center" 
                                               Style="{StaticResource CaptionTextBlockStyle}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Status Bar -->
                        <Border Name="StatusBar" Background="#4CAF50" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                            <TextBlock Name="StatusMessage" Text="System Healthy" HorizontalAlignment="Center" 
                                       Foreground="White" Style="{StaticResource BodyTextBlockStyle}"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Quick Actions -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Quick Actions" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Name="RefreshButton" Content="🔄 Refresh" 
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    Click="RefreshButton_Click" Margin="0,0,5,0"/>
                            
                            <Button Grid.Column="1" Name="OptimizeButton" Content="⚡ Optimize" 
                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                    Click="OptimizeButton_Click" Margin="5,0"/>
                            
                            <Button Grid.Column="2" Name="CleanupButton" Content="🧹 Cleanup" 
                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                    Click="CleanupButton_Click" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Focus Mode -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Focus Mode" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        <TextBlock Text="Optimize system for a specific application" 
                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <AutoSuggestBox Grid.Column="0" Name="AppSuggestBox" 
                                           PlaceholderText="Enter application name (e.g., chrome.exe, Visual Studio)" 
                                           Margin="0,0,10,0"/>
                            
                            <Button Grid.Column="1" Name="FocusModeButton" Content="🎯 Focus" 
                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                    Click="FocusModeButton_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Power Management -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Power Management" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Name="PowerSaverButton" Content="🔋 Power Saver" 
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    Click="PowerSaverButton_Click" Margin="0,0,5,0"/>
                            
                            <Button Grid.Column="1" Name="BalancedButton" Content="⚖️ Balanced" 
                                    Background="{ThemeResource SystemControlBackgroundAccentBrush}" 
                                    Click="BalancedButton_Click" Margin="5,0"/>
                            
                            <Button Grid.Column="2" Name="HighPerfButton" Content="🚀 High Performance" 
                                    Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                    Click="HighPerfButton_Click" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Top Processes -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="Top Resource Consumers" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                        <ListView Name="ProcessesListView" MaxHeight="300">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                            CornerRadius="6" Margin="0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                       Style="{StaticResource BodyTextBlockStyle}" 
                                                       VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:F1}%}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="2" Text="{Binding MemoryPercent, StringFormat={}{0:F1}%}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            
                                            <TextBlock Grid.Column="3" Text="{Binding Status}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- System Alerts -->
                <Border Background="{ThemeResource SystemControlBackgroundAltHighBrush}" 
                        CornerRadius="12" Padding="20">
                    <StackPanel Spacing="15">
                        <TextBlock Text="System Alerts" Style="{StaticResource SubtitleTextBlockStyle}"/>
                        
                        <ListView Name="AlertsListView" MaxHeight="200">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="{ThemeResource SystemControlBackgroundBaseLowBrush}" 
                                            CornerRadius="6" Margin="0,2">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding Message}" 
                                                       Style="{StaticResource BodyTextBlockStyle}"/>
                                            <TextBlock Text="{Binding Type, StringFormat={}Type: {0}}" 
                                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                                       Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
