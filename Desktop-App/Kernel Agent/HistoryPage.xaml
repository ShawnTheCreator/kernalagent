<Page
    x:Class="Kernel_Agent.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
             <ColumnDefinition Width="350" MinWidth="300" />
             <ColumnDefinition Width="*" />
         </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="EXECUTION HISTORY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoogleBlue}" CharacterSpacing="100" Margin="0,0,0,15"/>

                <ListView Grid.Row="1" SelectionMode="Single">
                    <ListViewItem>
                        <StackPanel Padding="5">
                            <TextBlock Text="Automated Payroll Export" FontWeight="SemiBold"/>
                            <TextBlock Text="Success • 2m ago" FontSize="12" Foreground="{StaticResource GoogleGreen}"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Padding="5">
                            <TextBlock Text="Sort Downloads Folder" FontWeight="SemiBold"/>
                            <TextBlock Text="Failed • 1h ago" FontSize="12" Foreground="{StaticResource GoogleRed}"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>
            </Grid>
        </Border>

        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="12"
                 Background="{ThemeResource LayerFillColorDefaultBrush}"
                 BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid Padding="30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,0,0,30">
                    <FontIcon Glyph="&#xE7BA;" FontSize="40" Foreground="{StaticResource GoogleRed}"/>
                    <StackPanel>
                        <TextBlock Text="Task Failed: Sort Downloads" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Error: System.UIElementNotFound - 'Sort' button not visible." Opacity="0.6"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="AI REASONING TRACE" FontSize="10" FontWeight="Bold" Margin="0,0,0,10" Opacity="0.5"/>

                <ScrollViewer Grid.Row="2">
                    <StackPanel Spacing="10">
                         <Border Background="#1AFFFFFF" Padding="15" CornerRadius="8">
                             <TextBlock Text="Step 1: Successfully located Downloads folder via File Explorer." FontSize="13"/>
                         </Border>
                         <Border Background="#1AFFFFFF" Padding="15" CornerRadius="8">
                            <TextBlock Text="Step 2: Attempted to find 'Sort' dropdown. Element was obscured by a Windows Update notification." FontSize="13"/>
                        </Border>
                        <Border BorderBrush="{StaticResource GoogleRed}" BorderThickness="1" Padding="15" CornerRadius="8">
                            <TextBlock Text="Self-Correction: Attempting to close notification... [FAIL]" FontSize="13" Foreground="{StaticResource GoogleRed}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>