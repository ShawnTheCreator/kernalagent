<Page
    x:Class="Kernel_Agent.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:services="using:Kernel_Agent.Services"
    xmlns:dto="using:Kernel_Agent.DTOs">

    <Grid Padding="24" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,20">
            <TextBlock Text="EPISODIC MEMORY TIMELINE" FontSize="12" FontWeight="Bold" Opacity="0.6" VerticalAlignment="Center"/>
            <AppBarButton Icon="Refresh" Label="Refresh" Click="RefreshButton_Click" ToolTipService.ToolTip="Refresh Timeline"/>
            <ProgressRing x:Name="LoadingProgress" IsActive="False" Width="20" Height="20" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Timeline Feed -->
        <ListView Grid.Row="1" ItemsSource="{x:Bind TimelineEvents}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="dto:TimelineEventDto">
                    <Grid Margin="0,8,0,8" Padding="12" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Time & Type Icon -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0">
                            <TextBlock Text="{x:Bind FormattedTime}" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                            <!-- Icon placehoder logic could go here -->
                        </StackPanel>

                        <!-- Content -->
                        <StackPanel Grid.Column="1" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2">
                                    <TextBlock Text="{x:Bind Type}" FontSize="10" FontWeight="Bold" Foreground="{x:Bind DisplayColor}" CharacterSpacing="50"/>
                                </Border>
                            </StackPanel>
                            
                            <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="14"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>