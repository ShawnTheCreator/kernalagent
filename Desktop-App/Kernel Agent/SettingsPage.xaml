<Page
    x:Class="Kernel_Agent.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer Padding="30">
        <StackPanel Spacing="25" MaxWidth="900" HorizontalAlignment="Left">

            <!-- Header -->
            <StackPanel Spacing="5" Margin="0,0,0,10">
                <TextBlock Text="SETTINGS" FontSize="24" FontWeight="Bold" Foreground="{StaticResource GeminiPurpleBrush}"/>
                <TextBlock Text="Configure your Kernel Agent experience." Opacity="0.6" FontSize="14"/>
            </StackPanel>

            <!-- Sync Status -->
            <Border x:Name="SyncStatusBorder" Background="#1A4285F4" CornerRadius="8" Padding="12" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ProgressRing x:Name="SyncProgress" IsActive="True" Width="16" Height="16"/>
                    <TextBlock x:Name="SyncStatusText" Text="Syncing settings..." VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- Appearance Settings -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE790;" Foreground="{StaticResource GeminiPurpleBrush}"/>
                        <TextBlock Text="Appearance" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox x:Name="ThemeCombo" Header="Theme" HorizontalAlignment="Stretch"
                              SelectionChanged="ThemeCombo_SelectionChanged">
                        <ComboBoxItem Content="Dark" Tag="dark"/>
                        <ComboBoxItem Content="Light" Tag="light"/>
                        <ComboBoxItem Content="System" Tag="system"/>
                    </ComboBox>
                    
                    <ComboBox x:Name="LanguageCombo" Header="Language" HorizontalAlignment="Stretch"
                              SelectionChanged="LanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Execution Settings -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" Foreground="{StaticResource GoogleBlue}"/>
                        <TextBlock Text="Execution" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ComboBox x:Name="ExecutionModeCombo" Header="Execution Mode" HorizontalAlignment="Stretch"
                              SelectionChanged="ExecutionModeCombo_SelectionChanged">
                        <ComboBoxItem Content="Mock (Safe Preview)" Tag="MOCK"/>
                        <ComboBoxItem Content="Live (Execute Actions)" Tag="LIVE"/>
                    </ComboBox>
                    
                    <TextBlock Text="Mock mode previews actions without executing them. Live mode performs real actions on your computer." 
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                    
                    <ToggleSwitch x:Name="ConfirmActionsToggle" Header="Confirm before executing actions"
                                  OnContent="On" OffContent="Off" Toggled="ConfirmActionsToggle_Toggled"/>
                    
                    <ToggleSwitch x:Name="AutoSaveSkillsToggle" Header="Automatically save learned skills"
                                  OnContent="On" OffContent="Off" Toggled="AutoSaveSkillsToggle_Toggled"/>
                </StackPanel>
            </Border>

            <!-- Voice Recognition Settings -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE720;" Foreground="{StaticResource GoogleGreen}"/>
                        <TextBlock Text="Voice Recognition" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="VoiceEnabledToggle" Header="Enable continuous voice listening"
                                  OnContent="On" OffContent="Off" Toggled="VoiceEnabledToggle_Toggled"/>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Silence Detection Sensitivity" FontSize="13"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Slider x:Name="SilenceThresholdSlider" Minimum="200" Maximum="1000" StepFrequency="50"
                                    ValueChanged="SilenceThresholdSlider_ValueChanged"/>
                            <TextBlock x:Name="SilenceThresholdValue" Grid.Column="1" Width="50" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    
                    <StackPanel Spacing="5">
                        <TextBlock Text="Pause Duration to End Sentence (ms)" FontSize="13"/>
                        <Grid ColumnDefinitions="*, Auto">
                            <Slider x:Name="SilenceDurationSlider" Minimum="500" Maximum="3000" StepFrequency="100"
                                    ValueChanged="SilenceDurationSlider_ValueChanged"/>
                            <TextBlock x:Name="SilenceDurationValue" Grid.Column="1" Width="60" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                    
                    <ComboBox x:Name="VoiceLanguageCombo" Header="Recognition Language" HorizontalAlignment="Stretch"
                              SelectionChanged="VoiceLanguageCombo_SelectionChanged">
                        <ComboBoxItem Content="English (US)" Tag="en-US"/>
                        <ComboBoxItem Content="English (UK)" Tag="en-GB"/>
                        <ComboBoxItem Content="Spanish" Tag="es-ES"/>
                        <ComboBoxItem Content="French" Tag="fr-FR"/>
                        <ComboBoxItem Content="German" Tag="de-DE"/>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7E7;" Foreground="{StaticResource GoogleYellow}"/>
                        <TextBlock Text="Notifications" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="NotificationsToggle" Header="Enable desktop notifications"
                                  OnContent="On" OffContent="Off" Toggled="NotificationsToggle_Toggled"/>
                </StackPanel>
            </Border>

            <!-- About Section -->
            <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                    CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <StackPanel Spacing="15">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" Foreground="{StaticResource GoogleBlue}"/>
                        <TextBlock Text="About" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="Auto, *" RowDefinitions="Auto, Auto, Auto" ColumnSpacing="20" RowSpacing="8">
                        <TextBlock Text="Version:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="1.0.0" Opacity="0.8"/>
                        <TextBlock Grid.Row="1" Text="Build:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="2026.01.15" Opacity="0.8"/>
                        <TextBlock Grid.Row="2" Text="Platform:" FontWeight="SemiBold"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Windows 10/11 (WinUI 3)" Opacity="0.8"/>
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <HyperlinkButton Content="Website" NavigateUri="https://kernalagent.vercel.app"/>
                        <HyperlinkButton Content="Documentation" NavigateUri="https://kernalagent.vercel.app/docs"/>
                    </StackPanel>
                    
                    <Button Content="Sync Settings from Cloud" Click="SyncFromCloudButton_Click" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Danger Zone -->
            <Border Background="#1AEA4335" CornerRadius="12" Padding="20" 
                    BorderThickness="1" BorderBrush="{StaticResource GoogleRed}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE7BA;" Foreground="{StaticResource GoogleRed}"/>
                        <TextBlock Text="Danger Zone" FontWeight="Bold" FontSize="16" 
                                   Foreground="{StaticResource GoogleRed}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <TextBlock Text="Reset all settings to their default values." FontSize="12" Opacity="0.8"/>
                    
                    <Button Content="RESET ALL SETTINGS" Background="{StaticResource GoogleRed}" 
                            Foreground="White" HorizontalAlignment="Stretch"
                            Click="ResetAllSettingsButton_Click" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            
            <Grid Height="30"/>
        </StackPanel>
    </ScrollViewer>
</Page>
