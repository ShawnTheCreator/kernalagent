<Window
    x:Class="Kernel_Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kernel Agent - Mission Control">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="40">
            <StackPanel Orientation="Horizontal" Margin="15,0">
                <FontIcon Glyph="&#xE99A;" Foreground="#8E75FF" FontSize="16"/>
                <TextBlock Text="KERNEL MISSION CONTROL" VerticalAlignment="Center" 
                           Margin="10,0" FontWeight="Bold" FontSize="11" CharacterSpacing="150"/>
            </StackPanel>
            
            <!-- Profile Section -->
            <StackPanel x:Name="ProfileSection" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0" Visibility="Collapsed">
                <PersonPicture x:Name="ProfilePicture" Width="32" Height="32" Margin="0,0,8,0"/>
                <TextBlock x:Name="UserNameText" Text="User" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:Name="ProfileButton" Background="Transparent" BorderThickness="0" Padding="8,4">
                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem Text="View Profile" x:Name="ViewProfileMenuItem" Click="ViewProfileMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE77B;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Text="Logout" x:Name="LogoutMenuItem" Click="LogoutMenuItem_Click">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE7E8;"/>
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            
            <!-- Login Button (Header) -->
            <Button x:Name="LoginButton" Content="Login" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" 
                    Background="#8E75FF" Foreground="White" Padding="15,6" Click="LoginButton_Click" Visibility="Collapsed"/>
        </Grid>

        <!-- Main Content Area with Navigation -->
        <NavigationView Grid.Row="1" x:Name="NavView" 
                        PaneDisplayMode="LeftCompact"
                        SelectionChanged="NavView_SelectionChanged"
                        Visibility="Collapsed">
             <NavigationView.MenuItems>
                 <NavigationViewItem Content="Mission Control" Icon="Target" Tag="mission"/>
                 <NavigationViewItemHeader Content="Tools"/>
                 <NavigationViewItem Content="Skill Forge" Icon="Repair" Tag="forge"/>
                 <NavigationViewItem Content="Neural Sandbox" Icon="Play" Tag="sandbox"/>
                 <NavigationViewItemHeader Content="Data"/>
                 <NavigationViewItem Content="Action History" Tag="history">
                     <NavigationViewItem.Icon>
                         <FontIcon Glyph="&#xE81C;" />
                     </NavigationViewItem.Icon>
                 </NavigationViewItem>
                 <NavigationViewItem Content="Neural Memory" Icon="AllApps" Tag="memory"/>
                 <NavigationViewItemHeader Content="Security"/>
                 <NavigationViewItem Content="Security Vault" Icon="Permissions" Tag="security"/>
                 <NavigationViewItemHeader Content="Market"/>
                 <NavigationViewItem Content="Marketplace" Icon="Shop" Tag="marketplace"/>
             </NavigationView.MenuItems>
             <!-- Settings handled by NavigationView's built-in IsSettingsSelected -->
             <NavigationView.FooterMenuItems>
                 <NavigationViewItem Content="My Profile" Tag="profile">
                     <NavigationViewItem.Icon>
                         <FontIcon Glyph="&#xE77B;" />
                     </NavigationViewItem.Icon>
                 </NavigationViewItem>
             </NavigationView.FooterMenuItems>

            <Grid>
                <!-- Frame for page navigation (Profile, Settings, etc.) -->
                <Frame x:Name="ContentFrame" Visibility="Collapsed"/>
                
                <Grid x:Name="MissionRoot" Padding="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                     <Border CornerRadius="12" Background="#111111" Margin="0,0,10,0" BorderThickness="1" BorderBrush="#333333">
                        <Grid>
                            <Image x:Name="LiveDesktopPreview" Stretch="Uniform"/>
                            <Canvas x:Name="AiOverlayCanvas"/>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20">
                                <TextBlock Text="AGENT STATUS: OBSERVING" Foreground="#34A853" FontWeight="Bold"/>
                                <TextBlock Text="Target: Microsoft Excel" FontSize="12" Opacity="0.6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                     <Border Grid.Column="1" CornerRadius="12" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" Padding="15">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Step Progress Panel -->
                             <Border x:Name="StepProgressPanel"
                                     CornerRadius="8"
                                     Background="#1A8E75FF"
                                     Padding="12"
                                     Margin="0,0,0,12"
                                     Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Progress Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <FontIcon Glyph="&#xE768;" Foreground="#8E75FF" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="StepProgressTitle" 
                                                   Text="EXECUTING PLAN" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   Foreground="#8E75FF"
                                                   CharacterSpacing="100"/>
                                    </StackPanel>
                                    
                                    <!-- Current Step Indicator -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="#8E75FF" CornerRadius="12" Padding="8,4" Margin="0,0,10,0">
                                            <TextBlock x:Name="StepCountText" 
                                                       Text="1/4" 
                                                       FontWeight="Bold" 
                                                       FontSize="12"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock x:Name="CurrentStepText" 
                                                   Grid.Column="1" 
                                                   Text="Opening Chrome..." 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    
                                     <!-- Step Progress Bar -->
                                     <Grid Grid.Row="2">
                                         <Border Background="#333333" CornerRadius="4" Height="6"/>
                                         <Border x:Name="StepProgressBar"
                                                 Background="{StaticResource GeminiPurpleBrush}"
                                                 CornerRadius="4"
                                                 Height="6"
                                                 HorizontalAlignment="Left"
                                                 Width="60"/>
                                     </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="1" Text="INTERNAL MONOLOGUE" FontSize="10" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,10"/>

                            <ScrollViewer Grid.Row="2">
                                <StackPanel x:Name="ThoughtLog"/>
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox PlaceholderText="Command Agent..." 
                                         CornerRadius="8" x:Name="CommandInput" Margin="0,0,8,0"
                                         KeyDown="CommandInput_KeyDown"/>
                                <Button Grid.Column="1" x:Name="InternalMonologueVoiceButton" 
                                        ToolTipService.ToolTip="Record Voice for Internal Monologue" 
                                        MinWidth="36" MinHeight="36" VerticalAlignment="Center" 
                                        HorizontalAlignment="Right"
                                        Click="VoiceInputButton_Click"
                                        Padding="8">
                                    <FontIcon Glyph="&#xE720;" FontSize="18"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </NavigationView>

        <!-- Separate Login/Welcome Home Screen -->
        <Grid Grid.Row="1" x:Name="LoginOverlay" Visibility="Visible">
            <!-- Gradient Background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A0A0A" Offset="0"/>
                    <GradientStop Color="#151520" Offset="0.5"/>
                    <GradientStop Color="#0A0A15" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="400">
                <!-- Logo with Glow Effect -->
                <Grid Margin="0,0,0,20">
                    <Ellipse Width="120" Height="120" Opacity="0.2">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8E75FF" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Glyph="&#xE99A;" Foreground="#8E75FF" FontSize="64" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Title -->
                <TextBlock Text="KERNEL AGENT" 
                           FontSize="32" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           CharacterSpacing="200"
                           Foreground="White"/>
                           
                <TextBlock Text="Your AI Desktop Copilot" 
                           FontSize="16" 
                           Opacity="0.7" 
                           HorizontalAlignment="Center"
                           Foreground="#AAAAAA"/>
                
                <!-- Features List -->
                <Border Background="#1A8E75FF" CornerRadius="12" Padding="20" Margin="0,20,0,0">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8F2;" Foreground="#8E75FF" FontSize="16"/>
                            <TextBlock Text="Voice-activated automation" Foreground="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7B3;" Foreground="#8E75FF" FontSize="16"/>
                            <TextBlock Text="AI-powered vision targeting" Foreground="#CCCCCC"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE768;" Foreground="#8E75FF" FontSize="16"/>
                            <TextBlock Text="Smart multi-step execution" Foreground="#CCCCCC"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Login Button -->
                <Button x:Name="BigLoginButton" 
                        HorizontalAlignment="Stretch" 
                        Background="#8E75FF" 
                        Foreground="White" 
                        FontSize="16" 
                        FontWeight="SemiBold"
                        Padding="30,14" 
                        CornerRadius="8"
                        Click="LoginButton_Click" 
                        Margin="0,20,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                        <TextBlock Text="Login with Web App"/>
                    </StackPanel>
                </Button>
                
                <!-- Version -->
                <TextBlock Text="v1.0.0 • Powered by Gemini AI" 
                           FontSize="11" 
                           Opacity="0.4" 
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0"/>
            </StackPanel>

            <!-- Loading Overlay (shown while waiting for login) -->
            <Grid x:Name="LoginLoadingOverlay" Background="#CC000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                    <!-- Animated Spinner -->
                    <Grid Width="80" Height="80">
                        <Ellipse Width="80" Height="80" 
                                 Stroke="#8E75FF" StrokeThickness="4" 
                                 Opacity="0.3"/>
                        <Ellipse x:Name="SpinnerRing" 
                                 Width="80" Height="80" 
                                 Stroke="#8E75FF" 
                                 StrokeThickness="4"
                                 StrokeDashArray="50 200"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <!-- Loading Text -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Please Wait..." 
                                   FontSize="24" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"
                                   Foreground="White"/>
                        <TextBlock x:Name="LoadingStatusText"
                                   Text="Waiting for login..." 
                                   FontSize="14" 
                                   HorizontalAlignment="Center"
                                   Foreground="#AAAAAA"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>