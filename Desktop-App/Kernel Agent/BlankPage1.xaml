<Page
    x:Class="Kernel_Agent.BlankPage1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent">

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="15">
                <TextBlock Text="KNOWLEDGE CATEGORIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoogleBlue}" CharacterSpacing="100"/>

                <ListView SelectionMode="Single">
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xED25;" FontSize="16" Foreground="{StaticResource GeminiPurpleBrush}"/>
                            <TextBlock Text="Application Paths" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE929;" FontSize="16" Foreground="{StaticResource GoogleGreen}"/>
                            <TextBlock Text="User Preferences" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                    <ListViewItem>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE81E;" FontSize="16" Foreground="{StaticResource GoogleRed}"/>
                            <TextBlock Text="Learned Keywords" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ListViewItem>
                </ListView>

                <Button Content="Sync Neural Engine" HorizontalAlignment="Stretch" Margin="0,20,0,0"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="12" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Canvas x:Name="NeuralCanvas">
                </Canvas>

                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Spacing="5">
                    <TextBlock Text="COGNITIVE NODES: 1,402" FontSize="10" Opacity="0.6" HorizontalAlignment="Right"/>
                    <TextBlock Text="MEMORY INTEGRITY: 99.8%" FontSize="10" Foreground="{StaticResource GoogleGreen}" HorizontalAlignment="Right"/>
                </StackPanel>

                <TextBlock Text="NEURAL KNOWLEDGE GRAPH" VerticalAlignment="Top" HorizontalAlignment="Center" 
                           Margin="0,20,0,0" FontWeight="SemiBold" Opacity="0.4"/>
            </Grid>
        </Border>
    </Grid>
</Page>