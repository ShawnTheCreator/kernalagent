<Page
    x:Class="Kernel_Agent.ForgePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource LayerOnFluentOverlayFillColorDefaultBrush}">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" 
                Background="{ThemeResource LayerOnFluentOverlayFillColorDefaultBrush}" 
                CornerRadius="12" Margin="0,0,12,12" 
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Canvas x:ConnectionId='5' x:Name="NodeCanvas" Opacity="0.1">
                    <Path Data="M 0,0 L 1000,0 M 0,20 L 1000,20" Stroke="White" StrokeThickness="0.5"/>
                </Canvas>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                    <FontIcon Glyph="&#xE7AD;" FontSize="48" Foreground="{StaticResource GeminiPurpleBrush}"/>
                    <TextBlock Text="SKILL EDITOR" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select an action from the timeline to edit properties" Opacity="0.6" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="1" 
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                CornerRadius="12" Padding="20"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <StackPanel Spacing="20">
                <TextBlock Text="ACTION PROPERTIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource GoogleBlue}" CharacterSpacing="100"/>

                <TextBox Header="Action Label" PlaceholderText="e.g. Click 'File' Menu" />
                <NumberBox Header="Input Delay (ms)" Value="500" SpinButtonPlacementMode="Compact" />

                <ToggleSwitch Header="Wait for UI Stability" IsOn="True" />

                <ComboBox Header="On Failure Strategy" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="Retry 3 Times" IsSelected="True"/>
                    <ComboBoxItem Content="Skip to Next Step"/>
                    <ComboBoxItem Content="Abort Mission"/>
                </ComboBox>

                <Button x:ConnectionId='3' Content="Simulate Action"                               HorizontalAlignment="Stretch" Margin="0,12,0,0"/>
                <Button x:ConnectionId='4' Content="Save Skill"                          Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"/>
                <Button Content="Remove Step" HorizontalAlignment="Stretch" Foreground="{StaticResource GoogleRed}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Grid.Column="0" 
                Background="#111111" CornerRadius="12" 
                Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="EXECUTION SEQUENCE" FontSize="10" FontWeight="Bold" Opacity="0.5" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:ConnectionId='2' x:Name="TimelineStrip" Orientation="Horizontal" Spacing="8">
                        <Button Background="{StaticResource GoogleBlue}" Width="140" Height="80" CornerRadius="4">
                            <TextBlock Text="1. Launch App" FontSize="11" Foreground="White" TextWrapping="WrapWholeWords"/>
                        </Button>
                        <FontIcon Glyph="&#xE76C;" Opacity="0.3" VerticalAlignment="Center"/>
                        <Button Background="{StaticResource GeminiPurpleBrush}" Width="140" Height="80" CornerRadius="4">
                            <TextBlock Text="2. Find Search Box" FontSize="11" Foreground="White" TextWrapping="WrapWholeWords"/>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>

