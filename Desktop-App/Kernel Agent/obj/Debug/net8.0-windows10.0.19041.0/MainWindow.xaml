<Window
    x:Class="Kernel_Agent.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Kernel Agent - Mission Control">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:ConnectionId='2' x:Name="AppTitleBar" Height="44">
            <StackPanel Orientation="Horizontal" Margin="16,0">
                <FontIcon Glyph="&#xE99A;" Foreground="{StaticResource AccentBrush}" FontSize="18"/>
                <TextBlock Text="KERNEL MISSION CONTROL" VerticalAlignment="Center" 
                           Margin="12,0" FontWeight="SemiBold" FontSize="12" CharacterSpacing="120"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
            
            <!-- Profile Section -->
            <StackPanel x:ConnectionId='22' x:Name="ProfileSection" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,140,0" Visibility="Collapsed">
                <PersonPicture x:ConnectionId='24' x:Name="ProfilePicture" Width="32" Height="32" Margin="0,0,8,0"/>
                <TextBlock x:ConnectionId='25' x:Name="UserNameText" Text="User" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button x:ConnectionId='26' x:Name="ProfileButton" Background="Transparent" BorderThickness="0" Padding="8,4">
                    <FontIcon Glyph="&#xE70D;" FontSize="12"/>
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:ConnectionId='27' Text="Logout" x:Name="LogoutMenuItem"                             />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
            
            <!-- Login Button (Header) -->
            <Button x:ConnectionId='23' x:Name="LoginButton" Content="Login" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,16,0" 
                    Background="{StaticResource AccentBrush}" Foreground="White" Padding="16,8" CornerRadius="8"                           Visibility="Collapsed"/>
        </Grid>

        <!-- Main Content Area with Navigation -->
        <NavigationView x:ConnectionId='3' Grid.Row="1" x:Name="NavView" 
                        PaneDisplayMode="LeftCompact"
                                                                   
                        Visibility="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Mission Control" Icon="Target" Tag="mission"/>
                <NavigationViewItem Content="Skill Forge" Icon="Repair" Tag="forge"/>
                <NavigationViewItem Content="Action History" Tag="history">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Neural Memory" Icon="AllApps" Tag="memory"/>

                <NavigationViewItem Content="Security Vault" Icon="Permissions" Tag="security"/>
                <NavigationViewItem Content="Neural Sandbox" Icon="Play" Tag="sandbox"/>
                <NavigationViewItem Content="Marketplace" Icon="Shop" Tag="marketplace"/>
            </NavigationView.MenuItems>

            <Grid>
                <Grid x:ConnectionId='10' x:Name="MissionRoot" Padding="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="{StaticResource LargeRadius}" Background="{StaticResource CardBackgroundBrush}" Margin="0,0,12,0" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                        <Grid>
                            <Image x:ConnectionId='20' x:Name="LiveDesktopPreview" Stretch="Uniform"/>
                            <Canvas x:ConnectionId='21' x:Name="AiOverlayCanvas"/>
                            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20">
                                <TextBlock Text="AGENT STATUS: OBSERVING" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="12" CharacterSpacing="80"/>
                                <TextBlock Text="Target: Microsoft Excel" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="{StaticResource LargeRadius}" Background="{StaticResource SurfaceBackgroundBrush}" Padding="16" BorderThickness="1" BorderBrush="{StaticResource BorderSubtleBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Step Progress Panel -->
                            <Border x:ConnectionId='12' x:Name="StepProgressPanel" 
                                    CornerRadius="8" 
                                    Background="#1A6366F1" 
                                    Padding="12" 
                                    Margin="0,0,0,12"
                                    Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Progress Header -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <FontIcon Glyph="&#xE768;" Foreground="{StaticResource AccentBrush}" FontSize="14" Margin="0,0,8,0"/>
                                        <TextBlock x:ConnectionId='19' x:Name="StepProgressTitle" 
                                                   Text="EXECUTING PLAN" 
                                                   FontSize="10" 
                                                   FontWeight="Bold" 
                                                   Foreground="{StaticResource AccentBrush}"
                                                   CharacterSpacing="100"/>
                                    </StackPanel>
                                    
                                    <!-- Current Step Indicator -->
                                    <Grid Grid.Row="1" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="10" Padding="10,5" Margin="0,0,12,0">
                                            <TextBlock x:ConnectionId='18' x:Name="StepCountText" 
                                                       Text="1/4" 
                                                       FontWeight="Bold" 
                                                       FontSize="12"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock x:ConnectionId='17' x:Name="CurrentStepText" 
                                                   Grid.Column="1" 
                                                   Text="Opening Chrome..." 
                                                   FontSize="14" 
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                    
                                    <!-- Step Progress Bar -->
                                    <Grid Grid.Row="2">
                                        <Border Background="{StaticResource BorderMediumBrush}" CornerRadius="4" Height="5"/>
                                        <Border x:ConnectionId='16' x:Name="StepProgressBar" 
                                                Background="{StaticResource AccentBrush}" 
                                                CornerRadius="4" 
                                                Height="6" 
                                                HorizontalAlignment="Left"
                                                Width="60"/>
                                    </Grid>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="1" Text="INTERNAL MONOLOGUE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" CharacterSpacing="100" Margin="0,0,0,12"/>

                            <ScrollViewer Grid.Row="2">
                                <StackPanel x:ConnectionId='15' x:Name="ThoughtLog"/>
                            </ScrollViewer>

                            <Grid Grid.Row="3" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:ConnectionId='13' PlaceholderText="Command Agent..." 
                                         CornerRadius="{StaticResource MediumRadius}" x:Name="CommandInput" Margin="0,0,10,0"
                                         Background="{StaticResource CardBackgroundBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                                                       />
                                <Button x:ConnectionId='14' Grid.Column="1" x:Name="InternalMonologueVoiceButton" 
                                        ToolTipService.ToolTip="Record Voice for Internal Monologue" 
                                        MinWidth="36" MinHeight="36" VerticalAlignment="Center" 
                                        HorizontalAlignment="Right"
                                                                      
                                        Padding="8">
                                    <FontIcon Glyph="&#xE720;" FontSize="18"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Frame x:ConnectionId='11' x:Name="ContentFrame" Visibility="Collapsed"/>
            </Grid>
        </NavigationView>

        <!-- Separate Login/Welcome Home Screen -->
        <Grid x:ConnectionId='4' Grid.Row="1" x:Name="LoginOverlay" Visibility="Visible">
            <!-- Gradient Background -->
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A0A0A" Offset="0"/>
                    <GradientStop Color="#151520" Offset="0.5"/>
                    <GradientStop Color="#0A0A15" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="400">
                <!-- Logo with Glow Effect -->
                <Grid Margin="0,0,0,24">
                    <Ellipse Width="140" Height="140" Opacity="0.15">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <FontIcon Glyph="&#xE99A;" Foreground="{StaticResource AccentBrush}" FontSize="56" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                
                <!-- Title -->
                <TextBlock Text="KERNEL AGENT" 
                           FontSize="28" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           CharacterSpacing="180"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                           
                <TextBlock Text="Your AI Desktop Copilot" 
                           FontSize="15" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"/>
                
                <!-- Features List -->
                <Border Background="#0D6366F1" CornerRadius="{StaticResource LargeRadius}" Padding="24" Margin="0,24,0,0" BorderThickness="1" BorderBrush="#1A6366F1">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE8F2;" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                            <TextBlock Text="Voice-activated automation" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE7B3;" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                            <TextBlock Text="AI-powered vision targeting" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <FontIcon Glyph="&#xE768;" Foreground="{StaticResource AccentBrush}" FontSize="16"/>
                            <TextBlock Text="Smart multi-step execution" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
                <!-- Login Button -->
                <Button x:ConnectionId='9' x:Name="BigLoginButton" 
                        HorizontalAlignment="Stretch" 
                        Background="{StaticResource AccentGradient}" 
                        Foreground="White" 
                        FontSize="15" 
                        FontWeight="SemiBold"
                        Padding="28,14" 
                        CornerRadius="{StaticResource MediumRadius}"
                                                  
                        Margin="0,24,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE72E;" FontSize="16"/>
                        <TextBlock Text="Login with Web App"/>
                    </StackPanel>
                </Button>
                
                <!-- Version -->
                <TextBlock Text="v1.0.0 • Powered by Gemini AI" 
                           FontSize="11" 
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource TextDisabled}"
                           Margin="0,24,0,0"/>
            </StackPanel>

            <!-- Loading Overlay (shown while waiting for login) -->
            <Grid x:ConnectionId='5' x:Name="LoginLoadingOverlay" Background="#CC000000" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24">
                    <!-- Animated Spinner -->
                    <Grid Width="80" Height="80">
                        <Ellipse Width="80" Height="80" 
                                 Stroke="#8E75FF" StrokeThickness="4" 
                                 Opacity="0.3"/>
                        <Ellipse x:ConnectionId='7' x:Name="SpinnerRing" 
                                 Width="80" Height="80" 
                                 Stroke="#8E75FF" 
                                 StrokeThickness="4"
                                 StrokeDashArray="50 200"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:ConnectionId='8' x:Name="SpinnerRotation" Angle="0"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>

                    <!-- Loading Text -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Please Wait..." 
                                   FontSize="24" 
                                   FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"
                                   Foreground="White"/>
                        <TextBlock x:ConnectionId='6' x:Name="LoadingStatusText"
                                   Text="Waiting for login..." 
                                   FontSize="14" 
                                   HorizontalAlignment="Center"
                                   Foreground="#AAAAAA"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>

