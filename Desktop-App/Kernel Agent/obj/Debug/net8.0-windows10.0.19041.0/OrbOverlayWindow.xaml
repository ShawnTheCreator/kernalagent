<Window
    x:Class="Kernel_Agent.OrbOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="Transparent">
        <Grid.Resources>
            <ThemeShadow x:ConnectionId='2' x:Name="OrbShadow" />
        </Grid.Resources>
        <Ellipse Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Shadow="{StaticResource OrbShadow}">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.3,0.3">
                    <GradientStop Color="#FF00C3FF" Offset="0"/>
                    <GradientStop Color="#FF0066FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <TextBlock Text="●" FontSize="60" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.25"/>
    </Grid>
</Window>

