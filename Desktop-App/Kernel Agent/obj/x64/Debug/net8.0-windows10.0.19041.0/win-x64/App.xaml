<Application
    x:Class="Kernel_Agent.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ===== MODERN COLOR PALETTE ===== -->
            
            <!-- Background Colors -->
            <Color x:Key="DeepBackground">#050505</Color>
            <Color x:Key="CardBackground">#111111</Color>
            <Color x:Key="CardBackgroundHover">#1A1A1A</Color>
            <Color x:Key="SurfaceBackground">#0A0A0A</Color>
            
            <!-- Border Colors -->
            <Color x:Key="BorderSubtle">#222222</Color>
            <Color x:Key="BorderMedium">#333333</Color>
            <Color x:Key="BorderAccent">#505050</Color>
            
            <!-- Accent Colors - Muted & Classic Integration -->
            <Color x:Key="AccentPrimary">#6366F1</Color>
            <Color x:Key="AccentSecondary">#8B5CF6</Color>
            <Color x:Key="AccentGlow">#4F46E5</Color>
            
            <!-- Status Colors -->
            <Color x:Key="StatusSuccess">#22C55E</Color>
            <Color x:Key="StatusWarning">#F59E0B</Color>
            <Color x:Key="StatusError">#EF4444</Color>
            <Color x:Key="StatusInfo">#3B82F6</Color>
            
            <!-- Text Colors -->
            <Color x:Key="TextPrimary">#EAEAEA</Color>
            <Color x:Key="TextSecondary">#A0A0A0</Color>
            <Color x:Key="TextMuted">#666666</Color>
            <Color x:Key="TextDisabled">#404040</Color>
            
            <!-- ===== BRUSHES ===== -->
            
            <SolidColorBrush x:Key="DeepBackgroundBrush" Color="{StaticResource DeepBackground}"/>
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackground}"/>
            <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="{StaticResource CardBackgroundHover}"/>
            <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="{StaticResource SurfaceBackground}"/>
            
            <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtle}"/>
            <SolidColorBrush x:Key="BorderMediumBrush" Color="{StaticResource BorderMedium}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimary}"/>
            <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondary}"/>
            
            <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource StatusSuccess}"/>
            <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource StatusWarning}"/>
            <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource StatusError}"/>
            
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMuted}"/>
            
            <!-- Gradient Brushes -->
            <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#5B21B6" Offset="0.0"/>
                <GradientStop Color="#4C1D95" Offset="1.0"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="SubtleGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#111111" Offset="0.0"/>
                <GradientStop Color="#0A0A0A" Offset="1.0"/>
            </LinearGradientBrush>
            
            <LinearGradientBrush x:Key="PageBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050505" Offset="0"/>
                <GradientStop Color="#0A0A0A" Offset="1"/>
            </LinearGradientBrush>
            
            <!-- Legacy support -->
            <SolidColorBrush x:Key="GeminiPurpleBrush" Color="#6366F1"/>
            <SolidColorBrush x:Key="GoogleBlue" Color="#3B82F6"/>
            <SolidColorBrush x:Key="GoogleGreen" Color="#22C55E"/>
            <SolidColorBrush x:Key="GoogleRed" Color="#EF4444"/>
            <SolidColorBrush x:Key="GoogleYellow" Color="#F59E0B"/>
            
            <LinearGradientBrush x:Key="GeminiGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4F46E5" Offset="0.0"/>
                <GradientStop Color="#7C3AED" Offset="0.5"/>
                <GradientStop Color="#DB2777" Offset="1.0"/>
            </LinearGradientBrush>

            <!-- ===== ANIMATION DURATIONS ===== -->
            <Duration x:Key="FastAnimation">0:0:0.15</Duration>
            <Duration x:Key="NormalAnimation">0:0:0.25</Duration>
            <Duration x:Key="SlowAnimation">0:0:0.4</Duration>

            <!-- ===== CORNER RADIUS ===== -->
            <CornerRadius x:Key="SmallRadius">4</CornerRadius>
            <CornerRadius x:Key="MediumRadius">8</CornerRadius>
            <CornerRadius x:Key="LargeRadius">12</CornerRadius>
            <CornerRadius x:Key="RoundRadius">999</CornerRadius>

            <!-- ===== SPACING ===== -->
            <x:Double x:Key="SpacingXS">4</x:Double>
            <x:Double x:Key="SpacingSM">8</x:Double>
            <x:Double x:Key="SpacingMD">16</x:Double>
            <x:Double x:Key="SpacingLG">24</x:Double>
            <x:Double x:Key="SpacingXL">32</x:Double>

            <!-- ===== GLOBAL STYLES ===== -->
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}"/>
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="Padding" Value="12,8"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="CornerRadius" Value="{StaticResource SmallRadius}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}"/>
                <Setter Property="Background" Value="{StaticResource DeepBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Style>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="LayerOnFluentOverlayFillColorDefaultBrush" Color="#050505"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#050505"/>
                    <SolidColorBrush x:Key="SystemControlPageBackgroundChromeLowBrush" Color="#050505"/>
                    <SolidColorBrush x:Key="NavigationViewTopPaneBackground" Color="#050505"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <!-- Enforce dark mode even if system is light -->
                    <SolidColorBrush x:Key="LayerOnFluentOverlayFillColorDefaultBrush" Color="#050505"/>
                    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="#050505"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
