<Page x:ConnectionId='1'
    x:Class="Kernel_Agent.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kernel_Agent"
                        >

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Skills List Panel -->
        <Border Grid.Column="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" 
                CornerRadius="12" Padding="20" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid RowDefinitions="Auto, *, Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="LEARNED SKILLS" FontSize="11" FontWeight="Bold" 
                               Foreground="{StaticResource GeminiPurpleBrush}" CharacterSpacing="100"/>
                    <TextBlock x:ConnectionId='15' x:Name="SkillsCountText" Text="Loading..." FontSize="12" Opacity="0.6"/>
                </StackPanel>

                <!-- Skills ListView -->
                <ListView x:ConnectionId='11' x:Name="SkillsListView" Grid.Row="1" Margin="0,15,0,0"
                          SelectionMode="Single"                                                   >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnDefinitions="Auto, *, Auto">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#1A8E75FF">
                                    <FontIcon Glyph="&#xE945;" FontSize="16" 
                                              Foreground="{StaticResource GeminiPurpleBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding IntentSignature}" FontSize="11" Opacity="0.6" 
                                               TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SuccessCount}" FontSize="14" FontWeight="Bold" 
                                               Foreground="{StaticResource GoogleGreen}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="uses" FontSize="10" Opacity="0.5" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Bottom Actions -->
                <StackPanel Grid.Row="2" Spacing="10" Margin="0,15,0,0">
                    <Button x:ConnectionId='12' x:Name="RefreshSkillsButton" Content="Refresh Skills" 
                            HorizontalAlignment="Stretch"                                  />
                    <ProgressRing x:ConnectionId='13' x:Name="LoadingProgress" IsActive="False" Width="24" Height="24" 
                                  HorizontalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Skill Details / Neural Map Panel -->
        <Border Grid.Column="1" Margin="12,0,0,0" CornerRadius="12" 
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- Neural Canvas (visualization) -->
                <Canvas x:ConnectionId='2' x:Name="NeuralCanvas"/>

                <!-- Selected Skill Details -->
                <Grid x:ConnectionId='3' x:Name="SkillDetailsPanel" Visibility="Collapsed" Padding="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="15">
                        <Border Width="80" Height="80" CornerRadius="20" Background="#1A8E75FF">
                            <FontIcon Glyph="&#xE945;" FontSize="40" 
                                      Foreground="{StaticResource GeminiPurpleBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:ConnectionId='6' x:Name="DetailSkillName" Text="" FontSize="24" FontWeight="Bold" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:ConnectionId='7' x:Name="DetailSkillIntent" Text="" FontSize="14" Opacity="0.7" 
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        
                        <Grid ColumnDefinitions="*, *, *" ColumnSpacing="30" Margin="0,20,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:ConnectionId='10' x:Name="DetailConfidence" Text="0%" FontSize="28" FontWeight="Bold" 
                                           Foreground="{StaticResource GoogleGreen}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Confidence" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:ConnectionId='9' x:Name="DetailSuccessCount" Text="0" FontSize="28" FontWeight="Bold" 
                                           Foreground="{StaticResource GoogleBlue}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Uses" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:ConnectionId='8' x:Name="DetailLastUsed" Text="-" FontSize="16" FontWeight="SemiBold" 
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Last Used" FontSize="12" Opacity="0.5" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- Stats Overlay -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="20" Spacing="5">
                    <TextBlock x:ConnectionId='4' x:Name="CognitiveNodesText" Text="SKILLS LOADED: 0" FontSize="10" Opacity="0.6" 
                               HorizontalAlignment="Right"/>
                    <TextBlock x:ConnectionId='5' x:Name="MemoryIntegrityText" Text="API: CONNECTED" FontSize="10" 
                               Foreground="{StaticResource GoogleGreen}" HorizontalAlignment="Right"/>
                </StackPanel>

                <TextBlock Text="NEURAL KNOWLEDGE GRAPH" VerticalAlignment="Top" HorizontalAlignment="Center" 
                           Margin="0,20,0,0" FontWeight="SemiBold" Opacity="0.4"/>
            </Grid>
        </Border>
    </Grid>
</Page>

