<Window
    x:Class="Kernel_Agent.OrbOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Transparent background for true orb appearance -->
    <Grid x:ConnectionId='2' x:Name="RootGrid" Background="Transparent">
        
        <!-- Context Menu for right-click control -->
        <Grid.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:ConnectionId='3' x:Name="ExpandMenuItem" Text="Expand"                             >
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE740;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator/>
                <MenuFlyoutItem x:ConnectionId='4' x:Name="ExitMenuItem" Text="Exit"                           >
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE711;"/>
                    </MenuFlyoutItem.Icon>
                </MenuFlyoutItem>
            </MenuFlyout>
        </Grid.ContextFlyout>
        
        <!-- Outer glow layer (animated) -->
        <Ellipse x:ConnectionId='5' x:Name="OuterGlow" 
                 Width="64" Height="64" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                 Opacity="0.4">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.5,0.5">
                    <GradientStop Color="#008E75FF" Offset="0"/>
                    <GradientStop Color="#408E75FF" Offset="0.6"/>
                    <GradientStop Color="#008E75FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <!-- Success halo (initially hidden) -->
        <Ellipse x:ConnectionId='6' x:Name="SuccessHalo" 
                 Width="70" Height="70" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                 Opacity="0"
                 Stroke="#34A853"
                 StrokeThickness="3"/>
        
        <!-- Main orb with Gemini gradient -->
        <Ellipse x:ConnectionId='7' x:Name="MainOrb" 
                 Width="54" Height="54" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                 Stroke="#404285F4"
                 StrokeThickness="2"
                                                        
                                                    
                                                          
                                        >
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.3,0.3">
                    <!-- Deep indigo core -->
                    <GradientStop Color="#FF1A1A2E" Offset="0"/>
                    <!-- Electric blue middle -->
                    <GradientStop Color="#FF4285F4" Offset="0.5"/>
                    <!-- Soft violet outer -->
                    <GradientStop Color="#FF8E75FF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <!-- Inner shimmer/highlight -->
        <Ellipse x:ConnectionId='8' x:Name="InnerShimmer" 
                 Width="30" Height="30" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Center"
                 Opacity="0.6"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush GradientOrigin="0.3,0.3">
                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        
        <!-- Processing spinner (initially hidden) -->
        <ProgressRing x:ConnectionId='9' x:Name="ProcessingRing" 
                      Width="40" Height="40" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center"
                      IsActive="False"
                      Visibility="Collapsed"
                      Foreground="#4285F4"/>
    </Grid>
</Window>

