rules_version = '2';

/**
 * Firestore Security Rules for Kernal Agent Platform
 * 
 * ARCHITECTURE:
 * - users/{userId} - User profile documents
 * - users/{userId}/settings/* - User preferences
 * - users/{userId}/skills/* - User-scoped agent skills
 * - users/{userId}/sessions/* - Agent session history
 * - users/{userId}/memory/* - Long-term agent memory
 * - skills/* - Global skills collection (backend-managed)
 * 
 * SECURITY MODEL:
 * - Users can ONLY access their own data
 * - Frontend should NOT write directly (use backend APIs)
 * - Backend uses Admin SDK (bypasses these rules)
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // USER DOCUMENTS
    // Users can only read/write their own profile
    // =========================================================================
    match /users/{userId} {
      // User can only access their own document
      allow read: if request.auth != null && request.auth.uid == userId;
      
      // Write is typically done via backend, but allow for edge cases
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // -----------------------------------------------------------------------
      // USER SETTINGS
      // -----------------------------------------------------------------------
      match /settings/{document} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // -----------------------------------------------------------------------
      // USER SKILLS
      // -----------------------------------------------------------------------
      match /skills/{skillId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // -----------------------------------------------------------------------
      // USER SESSIONS
      // -----------------------------------------------------------------------
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        
        // Session steps subcollection
        match /steps/{stepId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }
      
      // -----------------------------------------------------------------------
      // USER MEMORY
      // -----------------------------------------------------------------------
      match /memory/{memoryType} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // =========================================================================
    // GLOBAL SKILLS COLLECTION
    // Read-only for authenticated users, write only via Admin SDK (backend)
    // =========================================================================
    match /skills/{skillId} {
      // Any authenticated user can read global skills
      allow read: if request.auth != null;
      
      // No direct writes allowed - must go through backend API
      // Backend uses Admin SDK which bypasses these rules
      allow write: if false;
    }
    
    // =========================================================================
    // DEFAULT DENY
    // Any paths not explicitly matched are denied
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
